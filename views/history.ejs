<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CrazyAMP · Game History</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/account.css"></head><body><main class="account-page"><a class="account-back" href="/">← Back to Coinflip</a><header class="history-header"><span>ACCOUNT ACTIVITY</span><h1>Game history</h1><p>Your latest 100 coinflip games.</p></header><section class="history-list"><% if(!games.length){ %><div class="history-empty">No coinflip games yet. Create or join a match to start your history.</div><% } %><% games.forEach(game => { %><article class="history-game <%= game.status %>"><div class="history-result"><strong><%= game.status === 'completed' ? (game.won ? 'Won' : 'Lost') : game.status === 'cancelled' ? 'Cancelled' : 'Open' %></strong><span>vs <%= game.opponent %></span></div><div class="history-pets"><% game.yourPets.slice(0,4).forEach(pet => { %><div title="<%= pet.name %>"><% if(pet.image){ %><img src="<%= pet.image %>" alt="<%= pet.name %>"><% } else { %>🐾<% } %><% if(Number(pet.quantity)>1){ %><em>×<%= pet.quantity %></em><% } %></div><% }) %></div><strong class="history-value">💎 <%= Number(game.yourValue || 0).toLocaleString() %></strong><time><%= new Date(game.completed_at || game.created_at).toLocaleString('en-GB',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) %></time></article><% }) %></section></main></body></html>
