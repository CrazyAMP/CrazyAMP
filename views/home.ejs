<%
    const pageUserId =
        typeof user !== "undefined" && user
            ? user.id
            : "";

    const pageCanAdmin =
        typeof canAdmin !== "undefined" && canAdmin;
%>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>CrazyAMP</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/home.css"
    >

    <link
        rel="stylesheet"
        href="/css/inventory.css"
    >
</head>

<body data-user-id="<%= pageUserId %>">

    <div class="site-toast-region" id="siteToastRegion" aria-live="polite" aria-atomic="true"></div>

    <!-- ==========================================
         NAVBAR
    =========================================== -->

    <nav class="navbar">

        <a
            href="/"
            class="navbar-logo"
        >
            Crazy<span>AMP</span>
        </a>


        <div class="navbar-links">

            <a
                href="/"
                class="nav-link active"
            >
                Coinflip
            </a>

            <a
                href="/dice-duels"
                class="nav-link"
            >
                Dice Duels
            </a>

            <a
                href="/colour-dice"
                class="nav-link"
            >
                Colour Dice
            </a>

            <a
                href="/blackjack"
                class="nav-link"
            >
                Blackjack
            </a>

            <a
                href="/upgrader"
                class="nav-link"
            >
                Upgrader
            </a>

            <% if (pageCanAdmin) { %>
                <a href="/admin" class="nav-link">Admin</a>
            <% } %>

        </div>


        <div class="navbar-right">

            <!-- BALANCE -->

            <button
                type="button"
                class="balance-button"
                id="openInventoryButton"
            >

                <span class="balance-icon">
                    💎
                </span>

                <span
                    class="balance-value"
                    id="navbarInventoryValue"
                >
                    0
                </span>

            </button>


            <!-- USER -->

            <div class="navbar-user" id="accountMenuButton" role="button" tabindex="0" aria-haspopup="true" aria-expanded="false">

                <%
                    const navbarUser =
                        typeof user !== "undefined" && user
                            ? user
                            : null;

                    const navbarAvatar =
                        navbarUser
                            ? (
                                navbarUser.avatar_url ||
                                navbarUser.avatar ||
                                navbarUser.avatarUrl ||
                                ""
                            )
                            : "";

                    const navbarUsername =
                        navbarUser
                            ? (
                                navbarUser.roblox_username ||
                                navbarUser.robloxUsername ||
                                navbarUser.username ||
                                navbarUser.displayName ||
                                navbarUser.roblox_display_name ||
                                "User"
                            )
                            : "User";

                    const navbarIsOwner =
                        String(navbarUsername).toLowerCase() ===
                        "skyez3rs";
                %>


                <% if (navbarAvatar) { %>

                    <div class="navbar-avatar-wrapper">

                        <img
                            src="<%= navbarAvatar %>"
                            alt=""
                            class="navbar-avatar"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                        >

                        <div
                            class="navbar-avatar-placeholder"
                            style="display:none;"
                        >
                            <%= navbarUsername.charAt(0).toUpperCase() %>
                        </div>

                    </div>

                <% } else { %>

                    <div class="navbar-avatar-placeholder">
                        <%= navbarUsername.charAt(0).toUpperCase() %>
                    </div>

                <% } %>


                <div class="navbar-user-info">

                    <span class="navbar-username">
                        <%= navbarUsername %>
                    </span>

                    <span class="navbar-user-label<%= navbarIsOwner ? " owner" : "" %>">
                        <%= navbarIsOwner ? "OWNER" : "PLAYER" %>
                    </span>

                </div>

            </div>

            <div class="account-dropdown" id="accountDropdown">
                <a href="/profile">Profile</a>
                <a href="/history">Game History</a>
                <button type="button" id="createGiveawayMenuButton">Create Giveaway</button>
                <button type="button" id="logoutButton">Log out</button>
            </div>

        </div>

    </nav>


    <!-- ==========================================
         COINFLIP PAGE
    =========================================== -->

    <main class="coinflip-page">
        <section class="reference-toolbar" aria-label="Coinflip controls">
            <button type="button" class="sort-button reference-sort" id="sortMatchesButton">
                <span>☷</span>
                <strong>Value sort high to low</strong>
                <span class="sort-chevron">⌄</span>
            </button>

            <div class="reference-counts">
                <span class="reference-count"><span class="reference-count-icon">◈</span><strong id="openMatchesCount">5</strong></span>
                <span class="reference-count diamond-count"><span>◆</span><strong id="totalWageredValue">1,550</strong></span>
            </div>

            <div class="reference-toolbar-actions">
                <button type="button" class="match-tab active" id="openMatchesTab">Bet Items</button>
                <button type="button" class="match-tab" id="myMatchesTab">History</button>
                <button type="button" class="create-match-button reference-create" id="createMatchButton" aria-label="Create match">+</button>
            </div>
        </section>

        <section class="coinflip-layout reference-layout">
            <section class="coinflip-main">
                <div class="coinflip-matches" id="coinflipMatches">
                    <div class="matches-empty">
                        <div class="matches-empty-icon">🪙</div>
                        <h3>No open matches</h3>
                        <p>Create a match and be the first player to start a coinflip.</p>
                        <button type="button" class="create-match-button empty-create-button" id="emptyCreateMatchButton"><span>+</span> Create Match</button>
                    </div>
                </div>

                <div class="fair-banner">
                    <div class="fair-icon">✓</div>
                    <div class="fair-content"><strong>Provably Fair</strong><span>Every coinflip result is generated fairly and cannot be manually selected.</span></div>
                    <a href="#" class="fair-link">Learn more →</a>
                </div>
            </section>
        </section>
    </main>

    <!-- ==========================================
         FLOATING CHAT
    =========================================== -->

    <button
        type="button"
        class="chat-floating-button"
        id="chatFloatingButton"
        aria-label="Open chat"
    >
        💬
    </button>


    <div
        class="chat-backdrop"
        id="chatBackdrop"
    ></div>


    <aside
        class="chat-drawer"
        id="chatDrawer"
    >

        <div class="chat-header">

            <div class="chat-title">

                <span class="chat-status-dot"></span>

                COMMUNITY CHAT

            </div>


            <div class="chat-header-right">

                <span class="chat-online" id="chatOnline">
                    Connecting...
                </span>

                <button
                    type="button"
                    class="chat-close-button"
                    id="chatCloseButton"
                >
                    ×
                </button>

            </div>

        </div>


        <div class="chat-giveaways" id="chatGiveaways" aria-live="polite"></div>

        <div class="chat-messages" id="chatMessages">

            <div class="chat-empty">

                <div class="chat-empty-icon">
                    💬
                </div>

                <strong>
                    No messages yet
                </strong>

                <span>
                    Say hello to the community.
                </span>

            </div>

        </div>


        <div class="chat-input-wrapper">

            <input
                type="text"
                class="chat-input"
                id="chatInput"
                placeholder="Send a message..."
                disabled
            >

            <button
                type="button"
                class="chat-send-button"
                id="chatSendButton"
                disabled
            >
                →
            </button>

        </div>

    </aside>


    <div class="giveaway-modal" id="giveawayModal" hidden>
        <div class="giveaway-modal-overlay" id="giveawayModalOverlay"></div>
        <section class="giveaway-modal-panel giveaway-inventory-panel" role="dialog" aria-modal="true" aria-labelledby="giveawayModalTitle">
            <div class="giveaway-inventory-header">
                <div>
                    <span class="coinflip-modal-label">COMMUNITY EVENT</span>
                    <h2 id="giveawayModalTitle">Create Giveaway</h2>
                    <p>Select one pet from your inventory to give away.</p>
                </div>
                <button type="button" class="giveaway-close" id="giveawayClose" aria-label="Close giveaway">×</button>
            </div>
            <div class="giveaway-inventory-summary">
                <div><span>Available pets</span><strong id="giveawayAvailableCount">0</strong></div>
                <div><span>Selected</span><strong id="giveawaySelectedCount">0 / 1</strong></div>
            </div>
            <div class="giveaway-inventory-section-heading">
                <div><h3>Your Inventory</h3><p>Choose the pet you want to give away.</p></div>
                <span class="giveaway-selection-hint">1 pet maximum</span>
            </div>
            <div id="giveawayPetGrid" class="giveaway-pet-grid giveaway-inventory-grid" aria-label="Giveaway pet inventory"><div class="giveaway-loading">Loading inventory...</div></div>
            <input type="hidden" id="giveawayPet" value="">
            <div class="giveaway-options-row">
                <div class="giveaway-duration-field"><label for="giveawayDuration">Duration</label><select id="giveawayDuration"><option value="30">30 seconds</option><option value="60">1 minute</option><option value="120">2 minutes</option><option value="180">3 minutes</option><option value="240">4 minutes</option><option value="300">5 minutes</option><option value="360">6 minutes</option><option value="420">7 minutes</option><option value="480">8 minutes</option><option value="540">9 minutes</option><option value="600">10 minutes</option></select></div>
                <div class="giveaway-selected-preview" id="giveawaySelectedPreview">No pet selected</div>
            </div>
            <p class="giveaway-eligibility-note">Entrants must have completed a game in the last 24 hours.</p>
            <div class="giveaway-inventory-actions"><button type="button" class="giveaway-create-button" id="submitGiveaway" disabled><span>🎁</span><span><strong>Create Giveaway</strong><small>Lock the selected pet and publish the event</small></span></button></div>
            <p class="giveaway-form-status" id="giveawayFormStatus" role="status"></p>
        </section>
    </div>

    <!-- ==========================================
         COINFLIP CREATE MODAL
    =========================================== -->

    <div
        class="coinflip-modal"
        id="coinflipModal"
    >

        <div
            class="coinflip-modal-overlay"
            id="coinflipModalOverlay"
        ></div>


        <div class="coinflip-modal-panel">

            <!-- HEADER -->

            <div class="coinflip-modal-header">

                <div>

                    <span class="coinflip-modal-label">
                        CREATE GAME
                    </span>

                    <h2>
                        Create Coinflip
                    </h2>

                    <p>
                        Select the pets you want to wager and choose your side.
                    </p>

                </div>


                <button
                    type="button"
                    class="coinflip-modal-close"
                    id="coinflipModalClose"
                >
                    ×
                </button>

            </div>


            <div class="coinflip-inventory-toolbar" aria-label="Inventory filters">
                <label class="coinflip-search-box" for="coinflipInventorySearch">
                    <span aria-hidden="true">⌕</span>
                    <input type="search" id="coinflipInventorySearch" placeholder="Search for items" autocomplete="off">
                </label>
                <label class="coinflip-filter-select">
                    <span class="sr-only">Sort inventory</span>
                    <select id="coinflipInventorySort">
                        <option value="value-desc">High to low</option>
                        <option value="value-asc">Low to high</option>
                        <option value="name-asc">Name A–Z</option>
                        <option value="name-desc">Name Z–A</option>
                    </select>
                </label>
                <label class="coinflip-filter-select">
                    <span class="sr-only">Filter inventory</span>
                    <select id="coinflipInventoryFilter">
                        <option value="all">All items</option>
                        <option value="selected">Selected only</option>
                        <option value="unselected">Unselected only</option>
                    </select>
                </label>
            </div>
            <!-- INVENTORY HEADER -->

            <div class="coinflip-inventory-header">

                <div>

                    <h3>
                        Select your pets
                    </h3>

                    <p>
                        Only deposited pets can be used in a match.
                    </p>

                </div>


                <button
                    type="button"
                    class="coinflip-select-all"
                    id="coinflipSelectAll"
                >
                    Select All
                </button>

            </div>


            <!-- INVENTORY -->

            <div
                class="coinflip-inventory-grid"
                id="coinflipInventory"
            >

                <div class="coinflip-inventory-loading">

                    <div class="coinflip-loading-spinner"></div>

                    Loading inventory...

                </div>

            </div>
            <div class="coinflip-max-pets-setting">
                <label for="coinflipMaxJoinPets">Maximum pets the joiner can use</label>
                <input type="number" id="coinflipMaxJoinPets" min="1" max="100" value="3" inputmode="numeric">
                <small>Example: 3 means the opponent can join with up to 3 pets total.</small>
            </div>
            <!-- SIDE SELECTION -->

            <div
                class="coinflip-side-section"
                id="coinflipSideSection"
            >

                <div class="coinflip-side-heading">

                    <h3>
                        Choose your side
                    </h3>

                    <p>
                        Your opponent will automatically play the opposite side.
                    </p>

                </div>


                <div class="coinflip-side-options">

                    <!-- HEADS -->

                    <button
                        type="button"
                        class="coinflip-side-button"
                        data-side="heads"
                        id="coinflipHeadsButton"
                    >

                        <div class="coinflip-side-icon">

                            <img
                                src="/images/coin-heads.png"
                                alt="Heads"
                            >

                        </div>

                        <span class="coinflip-side-name">
                            Heads
                        </span>

                        <span class="coinflip-side-check">
                            ✓
                        </span>

                    </button>


                    <!-- TAILS -->

                    <button
                        type="button"
                        class="coinflip-side-button"
                        data-side="tails"
                        id="coinflipTailsButton"
                    >

                        <div class="coinflip-side-icon">

                            <img
                                src="/images/coin-tails.png"
                                alt="Tails"
                            >

                        </div>

                        <span class="coinflip-side-name">
                            Tails
                        </span>

                        <span class="coinflip-side-check">
                            ✓
