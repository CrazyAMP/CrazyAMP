        <div class="coinflip-game-modal-overlay" id="coinflipJoinModalOverlay"></div>
        <section class="coinflip-game-panel coinflip-join-panel" role="dialog" aria-modal="true">
            <button type="button" class="coinflip-game-close" id="coinflipJoinClose" aria-label="Close join match">×</button>
            <div class="coinflip-join-heading">
                <div>
                    <span class="coinflip-game-kicker">JOIN COINFLIP</span>
                    <h2>Select your pets</h2>
                    <p>Only deposited pets can be used in a match.</p>
                </div>
                <button type="button" class="coinflip-join-select-all" id="coinflipJoinSelectAll">Select All</button>
            </div>
            <p class="coinflip-join-range" id="coinflipJoinRangeText"></p>
            <div class="coinflip-join-inventory" id="coinflipJoinInventory"></div>
            <div class="coinflip-join-footer">
                <div class="coinflip-join-totals">
                    <div><span>Your wager</span><strong id="coinflipJoinValue">💎 0</strong></div>
                    <div><span>Estimated winner payout (up to 10% tax)</span><strong id="coinflipJoinPayout">💎 0</strong></div>
                </div>
                <button type="button" class="coinflip-join-match-button" id="coinflipJoinConfirm" disabled>Join & Flip</button>
            </div>
        </section>
    </div>


