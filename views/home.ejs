                    </button>

                </div>

            </div>
            <div class="coinflip-inventory-overview">
                <div><span>Selected:</span> <strong id="coinflipToolbarSelectedValue">💎 0</strong></div>
                <div><span>Inventory value:</span> <strong id="coinflipToolbarInventoryValue">💎 0</strong></div>
                <div><span>Items:</span> <strong id="coinflipToolbarInventoryCount">0</strong></div>
            </div>
            <!-- WAGER SUMMARY -->

            <div class="coinflip-wager-summary">

                <div class="coinflip-wager-stat">

                    <span>
                        SELECTED PETS
                    </span>

                    <strong id="coinflipSelectedCount">
                        0
                    </strong>

                </div>


                <div class="coinflip-wager-stat">

                    <span>
                        YOUR WAGER
                    </span>

                    <strong id="coinflipSelectedValue">
                        💎 0
                    </strong>

                </div>


                <div class="coinflip-wager-stat">

                    <span>
                        JOIN RANGE
                    </span>

                    <strong id="coinflipJoinRange">
                        💎 0 - 💎 0
                    </strong>

                </div>

            </div>


            <!-- FOOTER -->

            <div class="coinflip-modal-footer">

                <div class="coinflip-footer-info">

                    <span>
                        Game tax:
                    </span>

                    <strong>
                        10%
                    </strong>

                </div>


                <div class="coinflip-footer-actions">

                    <button
                        type="button"
                        class="coinflip-cancel-button"
                        id="coinflipCancelButton"
                    >
                        Cancel
                    </button>


                    <button
                        type="button"
                        class="coinflip-confirm-button"
                        id="coinflipConfirmButton"
