    <script src="/js/coinflip.js"></script>


    <script>

        /* ==========================================
           CHAT
        =========================================== */

        const chatFloatingButton =
            document.getElementById("chatFloatingButton");

        const chatDrawer =
            document.getElementById("chatDrawer");

        const chatBackdrop =
            document.getElementById("chatBackdrop");

        const chatCloseButton =
            document.getElementById("chatCloseButton");

        const chatMessages =
            document.getElementById("chatMessages");

        const chatInput =
            document.getElementById("chatInput");

        const chatSendButton =
            document.getElementById("chatSendButton");

        const accountMenuButton =
            document.getElementById("accountMenuButton");

        const accountDropdown =
            document.getElementById("accountDropdown");

        const logoutButton =
            document.getElementById("logoutButton");

        const chatOnline =
            document.getElementById("chatOnline");

        const siteToastRegion =
            document.getElementById("siteToastRegion");

        function showToast(message, type = "success") {
            if (!siteToastRegion) return;

            const toast = document.createElement("div");
            toast.className = `site-toast ${type}`;
            toast.innerHTML = `<span>${type === "error" ? "!" : "✓"}</span><p>${escapeHtml(message)}</p>`;
            siteToastRegion.appendChild(toast);

            window.setTimeout(() => {
                toast.classList.add("leaving");
                window.setTimeout(() => toast.remove(), 220);
            }, 3600);
        }


        function openChat() {

            if (!chatDrawer || !chatBackdrop) {
                return;
            }

            chatDrawer.classList.add("open");

            chatBackdrop.classList.add("open");

        }


        function closeChat() {

            if (!chatDrawer || !chatBackdrop) {
                return;
            }

            chatDrawer.classList.remove("open");

            chatBackdrop.classList.remove("open");

        }


        if (chatFloatingButton) {

            chatFloatingButton.addEventListener(
                "click",
                openChat
            );

        }


        if (chatCloseButton) {

            chatCloseButton.addEventListener(
                "click",
                closeChat
            );

        }


        if (chatBackdrop) {

            chatBackdrop.addEventListener(
                "click",
                closeChat
            );

        }

        if (accountMenuButton && accountDropdown) {
            const toggleAccountMenu = () => {
                const open = accountDropdown.classList.toggle("open");
                accountMenuButton.setAttribute("aria-expanded", String(open));
            };

            accountMenuButton.addEventListener("click", toggleAccountMenu);
            accountMenuButton.addEventListener("keydown", (event) => {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    toggleAccountMenu();
                }
            });

            document.addEventListener("click", (event) => {
                if (!event.target.closest(".navbar-right")) {
                    accountDropdown.classList.remove("open");
                    accountMenuButton.setAttribute("aria-expanded", "false");
                }
            });
        }

        if (logoutButton) {
            logoutButton.addEventListener("click", async () => {
                await fetch("/logout", { method: "POST" });
                window.location.assign("/");
            });
        }

    </script>

    <%- include("partials/mobile-bottom-nav") %>


<script>
(() => {
  const menuButton=document.getElementById('createGiveawayMenuButton');
  const modal=document.getElementById('giveawayModal');
  const closeButton=document.getElementById('giveawayClose');
  const overlay=document.getElementById('giveawayModalOverlay');
  const petSelect=document.getElementById('giveawayPet');
  const durationSelect=document.getElementById('giveawayDuration');
  const submit=document.getElementById('submitGiveaway');
  const status=document.getElementById('giveawayFormStatus');
  const giveawayBox=document.getElementById('chatGiveaways');
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const money=(v)=>Number(v||0).toLocaleString();
  const availableCount=document.getElementById('giveawayAvailableCount');
  const selectedCount=document.getElementById('giveawaySelectedCount');
  const selectedPreview=document.getElementById('giveawaySelectedPreview');
  let selectedPet=null;
  function syncSelection(){ const has=!!petSelect.value; selectedCount.textContent=has?'1 / 1':'0 / 1'; selectedPreview.textContent=selectedPet?`${selectedPet.name}${selectedPet.form?' · '+selectedPet.form:''} · 💎 ${money(selectedPet.value)}`:'No pet selected'; submit.disabled=!has; }
  function open(){ modal.hidden=false; loadInventory(); }
  function close(){ modal.hidden=true; status.textContent=''; }
  menuButton?.addEventListener('click',open); closeButton?.addEventListener('click',close); overlay?.addEventListener('click',close);
  const petGrid=document.getElementById('giveawayPetGrid');
  async function loadInventory(){
    petGrid.innerHTML='<div class="giveaway-loading">Loading inventory...</div>';
    petSelect.value=''; selectedPet=null; syncSelection();
    try {
      const r=await fetch('/api/inventory');
      const text=await r.text();
      let d; try { d=JSON.parse(text); } catch { throw new Error(r.ok?'The inventory response was invalid.':'Your session may have expired. Please refresh and log in again.'); }
      if(!r.ok) throw new Error(d.message||'Unable to load inventory.');
      const items=(d.inventory?.items||[]).flatMap(item=>Array.from({length:Number(item.quantity||0)},(_,i)=>({...item,unit:i+1})));
      petGrid.innerHTML='';
      availableCount.textContent=items.length;
      if(!items.length){ petGrid.innerHTML='<div class="giveaway-loading">No available pets.</div>'; return; }
      items.forEach(item=>{
        const card=document.createElement('button'); card.type='button'; card.className='giveaway-pet-option'; card.dataset.inventoryId=item.id; card.setAttribute('aria-pressed','false');
        const image=item.image?`<img src="${esc(item.image)}" alt="${esc(item.name)}" loading="lazy">`:'<div class="giveaway-pet-placeholder">🐾</div>';
        card.innerHTML=`${image}<span class="giveaway-pet-option-name">${esc(item.name)}${item.form?' · '+esc(item.form):''}</span><span class="giveaway-pet-option-value">${money(item.value)}${item.quantity>1?' · #'+item.unit:''}</span>`;
        card.addEventListener('click',()=>{ petGrid.querySelectorAll('.giveaway-pet-option').forEach(x=>{x.classList.remove('selected');x.setAttribute('aria-pressed','false');}); card.classList.add('selected'); card.setAttribute('aria-pressed','true'); petSelect.value=item.id; selectedPet=item; syncSelection(); });
        petGrid.appendChild(card);
      });
    } catch(e){ availableCount.textContent='0'; petGrid.innerHTML='<div class="giveaway-loading">Unable to load inventory.</div>'; status.textContent=e.message||'Unable to load inventory.'; }
    syncSelection();
  }
  submit?.addEventListener('click',async()=>{
    if(!petSelect.value) return status.textContent='Select a pet first.'; submit.disabled=true; submit.textContent='Creating...';
    try { const r=await fetch('/api/giveaways',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({inventoryId:petSelect.value,durationSeconds:Number(durationSelect.value)})}); const text=await r.text(); let d; try{d=JSON.parse(text);}catch{throw new Error(r.ok?'The server returned an invalid response.':'The server returned an unexpected page. Check that the giveaway route is deployed.');} if(!r.ok) throw new Error(d.message||'Could not create giveaway.'); close(); await loadGiveaways(); }
    catch(e){ status.textContent=e.message||'Could not create giveaway.'; } finally { submit.disabled=false; submit.textContent='Create Giveaway'; }
  });
  function formatRemaining(end){
    const seconds=Math.max(0,Math.ceil((new Date(end).getTime()-Date.now())/1000));
    if(seconds<=0) return 'Ended';
    if(seconds<60) return `${seconds} ${seconds===1?'Second':'Seconds'}`;
    const minutes=Math.floor(seconds/60);
    const remainder=seconds%60;
    const minuteLabel=`${minutes} ${minutes===1?'Minute':'Minutes'}`;
    return remainder ? `${minuteLabel} ${remainder} ${remainder===1?'Second':'Seconds'}` : minuteLabel;
  }
  function updateGiveawayTimers(){
    giveawayBox.querySelectorAll('[data-giveaway-end]').forEach(label=>{
      label.textContent=`Giveaway - ${formatRemaining(label.dataset.giveawayEnd)}`;
    });
  }
  function renderGiveaways(items){
    giveawayBox.innerHTML=items.map(g=>{
      const image=g.item_image
        ? `<img class="chat-giveaway-pet-image" src="${esc(g.item_image)}" alt="${esc(g.item_name)}" loading="lazy">`
        : '<div class="chat-giveaway-pet-image chat-giveaway-pet-placeholder">🐾</div>';
      return `<article class="chat-giveaway-card">
        ${image}
        <div class="chat-giveaway-main">
          <strong class="chat-giveaway-timer" data-giveaway-end="${esc(g.ends_at)}">Giveaway - ${esc(formatRemaining(g.ends_at))}</strong>
          <span>Pet: ${esc(g.item_name)}${g.form ? ` · ${esc(g.form)}` : ''}</span>
          <span>Value: ${money(g.item_value)}</span>
          <span>Host: ${esc(g.roblox_username)}</span>
          <span class="chat-giveaway-entrants">${g.entrant_count||0} joined</span>
        </div>
        <button type="button" data-giveaway-id="${esc(g.id)}" class="chat-giveaway-join">Join</button>
      </article>`;
    }).join('');
    updateGiveawayTimers();
    giveawayBox.querySelectorAll('[data-giveaway-id]').forEach(b=>b.addEventListener('click',async()=>{
      b.disabled=true;
      try{
        const r=await fetch('/api/giveaways/'+encodeURIComponent(b.dataset.giveawayId)+'/join',{method:'POST'});
        const text=await r.text(); let d;
        try{d=JSON.parse(text);}catch{throw new Error('The server returned an invalid response.');}
        if(!r.ok) alert(d.message||'Could not join.'); else alert(d.message||'Joined!');
        await loadGiveaways();
      }catch(e){alert(e.message||'Could not join giveaway.');}
      finally{b.disabled=false;}
    }));
  }
  async function loadGiveaways(){
    try{
      const r=await fetch('/api/giveaways');
      const text=await r.text(); let d;
      try{d=JSON.parse(text);}catch{return;}
      if(r.ok) renderGiveaways(d.giveaways||[]);
    }catch(e){}
  }
  loadGiveaways();
  setInterval(updateGiveawayTimers,1000);
  setInterval(loadGiveaways,10000);
})();
</script>
</body>

</html>
