<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Adopt Me — Item Manager</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            color: #f5f3ff;

            background:
                radial-gradient(
                    circle at top left,
                    rgba(139, 92, 246, 0.15),
                    transparent 35%
                ),
                radial-gradient(
                    circle at bottom right,
                    rgba(168, 85, 247, 0.10),
                    transparent 35%
                ),
                #050507;

            padding: 40px;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 30px;
        }

        .page-title {
            font-size: 30px;
            font-weight: 800;
        }

        .page-title span {
            color: #a855f7;
        }

        .page-subtitle {
            margin-top: 8px;
            color: #71717a;
            font-size: 14px;
        }

        .panel {
            background:
                linear-gradient(
                    145deg,
                    rgba(20, 20, 24, 0.96),
                    rgba(10, 10, 13, 0.96)
                );

            border:
                1px solid
                rgba(168, 85, 247, 0.15);

            border-radius: 16px;
            padding: 24px;

            box-shadow:
                0 20px 60px
                rgba(0, 0, 0, 0.35);
        }

        .panel-title {
            margin-bottom: 20px;

            font-size: 17px;
            font-weight: 800;
        }

        .form-grid {
            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));

            gap: 18px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        label {
            color: #a1a1aa;

            font-size: 12px;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        input,
        select {
            width: 100%;
            height: 44px;

            padding: 0 13px;

            color: #f4f4f5;
            background: #0d0d10;

            border:
                1px solid
                rgba(255, 255, 255, 0.08);

            border-radius: 9px;

            outline: none;
            font-size: 14px;
        }

        input:focus,
        select:focus {
            border-color:
                rgba(168, 85, 247, 0.7);

            box-shadow:
                0 0 0 3px
                rgba(168, 85, 247, 0.08);
        }

        .checkbox-row {
            display: flex;
            gap: 10px;
        }

        .checkbox-option {
            flex: 1;

            display: flex;
            flex-direction: row;
            align-items: center;

            gap: 10px;

            height: 44px;
            padding: 0 13px;

            cursor: pointer;

            color: #d4d4d8;
            background: #0d0d10;

            border:
                1px solid
                rgba(255, 255, 255, 0.08);

            border-radius: 9px;

            font-size: 13px;
        }

        .checkbox-option input {
            width: 16px;
            height: 16px;

            accent-color: #a855f7;
        }

        .button {
            width: 100%;
            height: 46px;

            margin-top: 20px;

            border: none;
            border-radius: 9px;

            cursor: pointer;

            color: white;

            font-size: 14px;
            font-weight: 800;

            background:
                linear-gradient(
                    135deg,
                    #a855f7,
                    #7c3aed
                );

            transition:
                transform 0.2s,
                box-shadow 0.2s;
        }

        .button:hover {
            transform: translateY(-1px);

            box-shadow:
                0 12px 30px
                rgba(124, 58, 237, 0.35);
        }

        .button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .message {
            display: none;

            margin-top: 15px;
            padding: 12px 14px;

            border-radius: 9px;

            font-size: 13px;
        }

        .message.success {
            display: block;

            color: #d8b4fe;

            background:
                rgba(168, 85, 247, 0.08);

            border:
                1px solid
                rgba(168, 85, 247, 0.2);
        }

        .message.error {
            display: block;

            color: #fca5a5;

            background:
                rgba(239, 68, 68, 0.08);

            border:
                1px solid
                rgba(239, 68, 68, 0.2);
        }

        .items-section {
            margin-top: 30px;
        }

        .section-header {
            display: flex;

            align-items: center;
            justify-content: space-between;

            margin-bottom: 15px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 800;
        }

        .item-count {
            color: #71717a;
            font-size: 12px;
        }

        .items-grid {
            display: grid;

            grid-template-columns:
                repeat(
                    auto-fill,
                    minmax(220px, 1fr)
                );

            gap: 14px;
        }

        .item-card {
            padding: 16px;

            background: #0d0d10;

            border:
                1px solid
                rgba(255, 255, 255, 0.07);

            border-radius: 12px;

            transition:
                border-color 0.2s,
                transform 0.2s;
        }

        .item-card:hover {
            transform: translateY(-2px);

            border-color:
                rgba(168, 85, 247, 0.3);
        }

        .item-image {
            width: 100%;
            height: 130px;

            display: flex;

            align-items: center;
            justify-content: center;

            margin-bottom: 12px;

            overflow: hidden;

            background: #08080a;

            border-radius: 9px;
        }

        .item-image img {
            width: 100%;
            height: 100%;

            object-fit: contain;
        }

        .item-image-empty {
            color: #3f3f46;
            font-size: 12px;
        }

        .item-name {
            color: #f4f4f5;

            font-size: 14px;
            font-weight: 800;
        }

        .item-details {
            display: flex;
            flex-wrap: wrap;

            gap: 5px;

            margin-top: 8px;
        }

        .tag {
            padding: 4px 7px;

            color: #a1a1aa;
            background: #18181b;

            border-radius: 5px;

            font-size: 10px;
            font-weight: 700;
        }

        .tag.purple {
            color: #d8b4fe;

            background:
                rgba(168, 85, 247, 0.10);
        }

        .item-value {
            margin-top: 12px;

            color: #c4b5fd;

            font-size: 14px;
            font-weight: 800;
        }

        .give-section {
            margin-top: 30px;
        }

        .give-info {
            margin-bottom: 18px;

            padding: 12px 14px;

            color: #a1a1aa;

            background:
                rgba(168, 85, 247, 0.05);

            border:
                1px solid
                rgba(168, 85, 247, 0.12);

            border-radius: 9px;

            font-size: 12px;
            line-height: 1.5;
        }

        .empty {
            padding: 40px;

            color: #52525b;

            text-align: center;

            border:
                1px dashed
                rgba(255, 255, 255, 0.08);

            border-radius: 12px;
        }

        @media (max-width: 700px) {

            body {
                padding: 20px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }

            .checkbox-row {
                flex-direction: column;
            }

        }

    </style>

</head>


<body>

<div class="container">


    <div class="page-header">

        <div class="page-title">
            Adopt <span>Me</span> Item Manager
        </div>

        <div class="page-subtitle">
            Create item definitions and test inventory items.
        </div>

    </div>


    <!-- ==========================================
         CREATE ITEM
    =========================================== -->

    <div class="panel">

        <div class="panel-title">
            Create Item
        </div>

        <form id="itemForm">

            <div class="form-grid">


                <div class="form-group full">

                    <label for="name">
                        Pet Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        placeholder="Example: Bat Dragon"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="form">
                        Form
                    </label>

                    <select id="form">

                        <option value="normal">
                            Normal
                        </option>

                        <option value="neon">
                            Neon
                        </option>

                        <option value="mega">
                            Mega
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label for="value">
                        Value
                    </label>

                    <input
                        type="number"
                        id="value"
                        min="0"
                        step="1"
                        placeholder="100000"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Potions
                    </label>

                    <div class="checkbox-row">

                        <label class="checkbox-option">

                            <input
                                type="checkbox"
                                id="fly"
                            >

                            Fly

                        </label>


                        <label class="checkbox-option">

                            <input
                                type="checkbox"
                                id="ride"
                            >

                            Ride

                        </label>

                    </div>

                </div>


                <div class="form-group">

                    <label for="image">
                        Image URL
                    </label>

                    <input
                        type="url"
                        id="image"
                        placeholder="https://..."
                    >

                </div>


            </div>


            <button
                type="submit"
                class="button"
                id="createButton"
            >
                Create Item
            </button>


            <div
                class="message"
                id="createMessage"
            ></div>

        </form>

    </div>


    <!-- ==========================================
         GIVE ITEM
    =========================================== -->

    <div class="give-section panel">

        <div class="panel-title">
            Add Item To Your Inventory
        </div>

        <div class="give-info">
            This test tool adds the selected item to the
            currently logged-in Roblox account. It is only
            intended for testing the inventory system.
        </div>


        <div class="form-group">

            <label for="itemSelect">
                Item
            </label>

            <select id="itemSelect">

                <option value="">
                    Loading items...
                </option>

            </select>

        </div>


        <div class="form-group" style="margin-top: 18px;">

            <label for="quantity">
                Quantity
            </label>

            <input
                type="number"
                id="quantity"
                min="1"
                step="1"
                value="1"
            >

        </div>


        <button
            class="button"
            id="giveButton"
            type="button"
        >
            Add To My Inventory
        </button>


        <div
            class="message"
            id="giveMessage"
        ></div>

    </div>


    <!-- ==========================================
         ITEMS
    =========================================== -->

    <div class="items-section">

        <div class="section-header">

            <div class="section-title">
                Existing Items
            </div>

            <div
                class="item-count"
                id="itemCount"
            >
                0 items
            </div>

        </div>


        <div
            class="items-grid"
            id="itemsGrid"
        >

            <div class="empty">
                Loading items...
            </div>

        </div>

    </div>


</div>


<script>

    const itemForm =
        document.getElementById(
            "itemForm"
        );

    const createMessage =
        document.getElementById(
            "createMessage"
        );

    const createButton =
        document.getElementById(
            "createButton"
        );

    const giveMessage =
        document.getElementById(
            "giveMessage"
        );

    const giveButton =
        document.getElementById(
            "giveButton"
        );

    const itemSelect =
        document.getElementById(
            "itemSelect"
        );

    const itemsGrid =
        document.getElementById(
            "itemsGrid"
        );

    const itemCount =
        document.getElementById(
            "itemCount"
        );


    // ==========================================
    // MESSAGE
    // ==========================================

    function showMessage(
        element,
        text,
        type
    ) {

        element.textContent =
            text;

        element.className =
            `message ${type}`;

    }


    // ==========================================
    // LOAD ITEMS
    // ==========================================

    async function loadItems() {

        try {

            const response =
                await fetch(
                    "/api/items"
                );

            const data =
                await response.json();


            if (!data.success) {

                throw new Error(
                    data.message ||
                    "Failed to load items."
                );

            }


            renderItems(
                data.items
            );

            populateSelect(
                data.items
            );


        } catch (error) {

            console.error(error);

            itemsGrid.innerHTML = `
                <div class="empty">
                    Failed to load items.
                </div>
            `;

            itemSelect.innerHTML = `
                <option value="">
                    Failed to load items
                </option>
            `;

        }

    }


    // ==========================================
    // POPULATE SELECT
    // ==========================================

    function populateSelect(
        items
    ) {

        if (
            !items ||
            items.length === 0
        ) {

            itemSelect.innerHTML = `
                <option value="">
                    No items available
                </option>
            `;

            return;

        }


        itemSelect.innerHTML = `
            <option value="">
                Select an item...
            </option>
        `;


        items.forEach(item => {

            let potion =
                "No Potion";


            if (
                item.fly &&
                item.ride
            ) {

                potion =
                    "Fly Ride";

            } else if (
                item.fly
            ) {

                potion =
                    "Fly";

            } else if (
                item.ride
            ) {

                potion =
                    "Ride";

            }


            const option =
                document.createElement(
                    "option"
                );


            option.value =
                item.id;


            option.textContent =
                `${item.name} — ${
                    capitalize(item.form)
                } — ${
                    potion
                } — 💎 ${
                    formatNumber(item.value)
                }`;


            itemSelect.appendChild(
                option
            );

        });

    }


    // ==========================================
    // RENDER ITEMS
    // ==========================================

    function renderItems(
        items
    ) {

        itemCount.textContent =
            `${items.length} item${
                items.length === 1
                    ? ""
                    : "s"
            }`;


        if (
            !items ||
            items.length === 0
        ) {

            itemsGrid.innerHTML = `
                <div class="empty">
                    No items have been created yet.
                </div>
            `;

            return;

        }


        itemsGrid.innerHTML =
            items.map(item => {

                let potion =
                    "No Potion";


                if (
                    item.fly &&
                    item.ride
                ) {

                    potion =
                        "Fly Ride";

                } else if (
                    item.fly
                ) {

                    potion =
                        "Fly";

                } else if (
                    item.ride
                ) {

                    potion =
                        "Ride";

                }


                const image =
                    item.image
                        ? `
                            <img
                                src="${escapeHtml(item.image)}"
                                alt="${escapeHtml(item.name)}"
                                onerror="this.parentElement.innerHTML='<span class=&quot;item-image-empty&quot;>Image unavailable</span>'"
                            >
                        `
                        : `
                            <span class="item-image-empty">
                                No image
                            </span>
                        `;


                return `

                    <div class="item-card">

                        <div class="item-image">
                            ${image}
                        </div>

                        <div class="item-name">

                            ${escapeHtml(
                                item.name
                            )}

                        </div>


                        <div class="item-details">

                            <span class="tag purple">

                                ${capitalize(
                                    item.form
                                )}

                            </span>


                            <span class="tag">

                                ${potion}

                            </span>

                        </div>


                        <div class="item-value">

                            💎 ${formatNumber(
                                item.value
                            )}

                        </div>

                    </div>

                `;

            }).join("");

    }


    // ==========================================
    // CREATE ITEM
    // ==========================================

    itemForm.addEventListener(
        "submit",
        async event => {

            event.preventDefault();


            createButton.disabled =
                true;

            createButton.textContent =
                "Creating...";


            createMessage.className =
                "message";


            try {

                const payload = {

                    name:
                        document
                            .getElementById(
                                "name"
                            )
                            .value,

                    form:
                        document
                            .getElementById(
                                "form"
                            )
                            .value,

                    fly:
                        document
                            .getElementById(
                                "fly"
                            )
                            .checked,

                    ride:
                        document
                            .getElementById(
                                "ride"
                            )
                            .checked,

                    value:
                        document
                            .getElementById(
                                "value"
                            )
                            .value,

                    image:
                        document
                            .getElementById(
                                "image"
                            )
                            .value

                };


                const response =
                    await fetch(
                        "/api/items",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify(
                                    payload
                                )
                        }
                    );


                const data =
                    await response.json();


                if (!data.success) {

                    throw new Error(
                        data.message ||
                        "Failed to create item."
                    );

                }


                showMessage(
                    createMessage,
                    "Item created successfully!",
                    "success"
                );


                itemForm.reset();


                await loadItems();


            } catch (error) {

                console.error(error);

                showMessage(
                    createMessage,
                    error.message,
                    "error"
                );

            } finally {

                createButton.disabled =
                    false;

                createButton.textContent =
                    "Create Item";

            }

        }
    );


    // ==========================================
    // GIVE ITEM
    // ==========================================

    giveButton.addEventListener(
        "click",
        async () => {

            const itemId =
                itemSelect.value;


            const quantity =
                Number(
                    document
                        .getElementById(
                            "quantity"
                        )
                        .value
                );


            if (!itemId) {

                showMessage(
                    giveMessage,
                    "Please select an item.",
                    "error"
                );

                return;

            }


            if (
                !Number.isInteger(
                    quantity
                ) ||
                quantity <= 0
            ) {

                showMessage(
                    giveMessage,
                    "Quantity must be a positive whole number.",
                    "error"
                );

                return;

            }


            giveButton.disabled =
                true;

            giveButton.textContent =
                "Adding...";


            giveMessage.className =
                "message";


            try {

                const response =
                    await fetch(
                        "/api/inventory/add",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify({
                                    itemId,
                                    quantity
                                })
                        }
                    );


                const data =
                    await response.json();


                if (!data.success) {

                    throw new Error(
                        data.message ||
                        "Failed to add item."
                    );

                }


                showMessage(
                    giveMessage,

                    `${data.item.name} added to your inventory. Quantity: ${data.item.quantity}`,

                    "success"
                );


                // Refresh the inventory
                // on the homepage if the
                // user returns there.

            } catch (error) {

                console.error(error);

                showMessage(
                    giveMessage,
                    error.message,
                    "error"
                );

            } finally {

                giveButton.disabled =
                    false;

                giveButton.textContent =
                    "Add To My Inventory";

            }

        }
    );


    // ==========================================
    // HELPERS
    // ==========================================

    function formatNumber(
        number
    ) {

        return Number(
            number
        ).toLocaleString(
            "en-GB"
        );

    }


    function capitalize(
        text
    ) {

        if (!text) {
            return "";
        }

        return (
            text
                .charAt(0)
                .toUpperCase()
            +
            text.slice(1)
        );

    }


    function escapeHtml(
        text
    ) {

        return String(
            text ?? ""
        )
            .replace(
                /&/g,
                "&amp;"
            )
            .replace(
                /</g,
                "&lt;"
            )
            .replace(
                />/g,
                "&gt;"
            )
            .replace(
                /"/g,
                "&quot;"
            )
            .replace(
                /'/g,
                "&#039;"
            );

    }


    // ==========================================
    // INITIAL LOAD
    // ==========================================

    loadItems();

</script>


</body>

</html>